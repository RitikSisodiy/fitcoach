# Copy to .env and fill in. Never commit .env.

# --- LLM -------------------------------------------------------------------
# Provider: gemini | claude | openai | openrouter
LLM_PROVIDER=gemini
# Model id from the provider's current model list (verify on the provider's docs; ids change often).
# Gemini is the default because it accepts text, photos and Telegram voice notes in one call.
LLM_MODEL=
# Optional fallback used when the primary provider errors.
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
LLM_TIMEOUT_SECONDS=60
# Gemini 3.x thinking level: minimal | low | medium | high (empty = model default)
GEMINI_THINKING_LEVEL=low
# Free tier (AI Studio): 3.x Flash = 5 req/min, 20 req/day EACH; 3.x Flash-Lite = 15 req/min, 500 req/day EACH.
# Extraction/decisions use FAST (Flash-Lite, ~1000/day combined); replies, photos, voice use SMART first
# (~80/day combined) and fall back to FAST. Usage per model is tracked in data/gemini_usage.json.
GEMINI_FAST_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_SMART_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash
# free = pace locally by the limits above; paid = no local limits
GEMINI_TIER=free

# --- Telegram ----------------------------------------------------------------
# Create a bot with @BotFather. Get your numeric user id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# --- Health Connect ingest ---------------------------------------------------
# Leave INGEST_SECRET empty to disable the HTTP endpoint.
# In the Health Connect Webhook app, add the header  x-api-key: <INGEST_SECRET>
INGEST_SECRET=
INGEST_HOST=127.0.0.1
INGEST_PORT=8787

# --- Storage and behaviour ---------------------------------------------------
DATABASE_PATH=data/coach.db
COACH_TIMEZONE=Asia/Kolkata
PLANNER_INTERVAL_MINUTES=15
IGNORE_AFTER_MINUTES=120
DAILY_MESSAGE_BUDGET=3
MIN_MINUTES_BETWEEN_PROACTIVE=90
QUIET_START=22:30
QUIET_END=07:30

# --- Calendar (optional) -------------------------------------------------------
# Google Calendar > Settings > your calendar > "Secret address in iCal format". Only times are used, never titles.
CALENDAR_ICS_URL=
